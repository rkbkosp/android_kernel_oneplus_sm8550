# Disable debugging
# CONFIG_ARM_QCOM_CPUFREQ_HW_DEBUG is not set
# CONFIG_SPMI_MSM_PMIC_ARB_DEBUG is not set
# CONFIG_QCOM_ESOC_DEBUG is not set
# CONFIG_QTI_BATTERY_GLINK_DEBUG is not set
# CONFIG_QTI_PMIC_GLINK_DEBUG is not set
# CONFIG_QTI_RIMPS_LOG is not set
# CONFIG_INTERCONNECT_QCOM_DEBUG is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_PID_IN_CONTEXTIDR is not set
# CONFIG_CORESIGHT is not set
# CONFIG_KUNIT is not set

# Use 1M for kernel log
CONFIG_LOG_BUF_SHIFT=20

# Disable unused
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_NL80211_TESTMODE is not set
# CONFIG_DEBUG_STACK_USAGE is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# Lockup and hung task reporting stay on. OPPO's production config turns them off, which is why
# a wedged system leaves no log at all. They only log by default (panic requires the
# hung_task_panic / softlockup_panic sysctls), so keeping them is safe.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
# A wedged system must not lie dead until a force reboot. With these two the lockup detectors
# panic, and CONFIG_PANIC_TIMEOUT=5 then reboots the phone by itself, so the stack is written
# to pstore and the device recovers unattended. They only fire on a real wedge: a task stuck
# in D for 2 minutes, or a CPU that has not scheduled for 20 seconds with interrupts on.
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
# PM debug + test suspend: with CONFIG_PM_TEST_SUSPEND the device can be walked through the
# whole suspend path (devices/platform/processors/freezer) from /sys/power/pm_test and it
# resumes by itself, so a suspend-time wedge is reproduced while adb is still connected and
# the stack can be read live instead of inferred from a dead phone.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_TEST_SUSPEND=y
# CONFIG_WQ_WATCHDOG is not set
# OPPO ship it off, but a stuck workqueue is a prime suspect for a device that sleeps and
# never wakes: the stall report names the offending work item and lands in the ramoops
# console buffer that the panic above then preserves.
CONFIG_WQ_WATCHDOG=y
# Panic must not leave the device dead: the display driver panics on SDE errors
# (sde_dbg.c DEFAULT_PANIC=1) and, with the base config's CONFIG_PANIC_TIMEOUT=-1, the phone
# then hangs on a black screen until it is force rebooted. Reboot after 5s instead, which is
# what a stock build does, and the panic stays readable through pstore.
CONFIG_PANIC_TIMEOUT=5

#ifdef OPLUS_FEATURE_MM_BG
CONFIG_OPLUS_MM_BG=y
#endif /* OPLUS_FEATURE_MM_BG */

# KernelSU-Next v3.4.0, vendored in drivers/kernelsu (kernel/ of the
# KernelSU-Next tree). Its hooks go through kprobes, so the only source
# changes are the drivers/ glue below and these flags. CONFIG_TMPFS_XATTR is
# what KernelSU mounts modules through.
CONFIG_KSU=y
CONFIG_TMPFS_XATTR=y
